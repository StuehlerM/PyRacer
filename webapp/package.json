{
  "name": "pyracer-webapp",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Mistral chat web app using the official TypeScript SDK. API key stays server-side.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
